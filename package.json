{
  "name": "@lennix1337/pi-ripwire-but-better",
  "version": "0.1.2",
  "type": "module",
  "description": "Native Pi extension for Ripwire code navigation, explicit project checks, and bounded, inspectable evidence.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lennix1337/pi-ripwire-but-better.git"
  },
  "homepage": "https://www.npmjs.com/package/@lennix1337/pi-ripwire-but-better",
  "bugs": {
    "url": "https://github.com/lennix1337/pi-ripwire-but-better/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "ripwire",
    "code-navigation",
    "code-intelligence",
    "impact-analysis",
    "callers",
    "static-analysis",
    "validation",
    "ai-agent",
    "developer-tools"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "examples",
    "skills",
    "docs/STATUS.md",
    "docs/PERFORMANCE-AUDIT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "verify": "npm run check && npm test",
    "mutations": "node test/mutations.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
